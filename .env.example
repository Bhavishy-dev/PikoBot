# ==========================================
# 🏰 PikoBot Environment Configuration Example
# ==========================================

# Telegram Bot Token (from https://t.me/BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram Bot Identity & Mini App Short Name
BOT_USERNAME=Piko_Officialbot
MINI_APP_SHORT_NAME=app

# Database Connection URL
# SQLite (Local Development):
DATABASE_URL=sqlite+aiosqlite:///./pikobot.db
# PostgreSQL / Supabase (Production):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Telegram Web App (Cloudflare Pages URL)
MINI_APP_URL=https://pikobot-app.pages.dev

# Runtime & Logging Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
